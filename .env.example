# Server-only PostgreSQL connection string. Configure in the hosting environment.
# Never put this secret in a VITE_ variable. Include your provider's TLS settings.
DATABASE_URL=

# Public share-link origin. This value is safe to expose to the browser.
VITE_PUBLIC_SITE_URL=https://openswarm.com

# Approved HTTPS legal pages. Links stay hidden until these are configured.
# The former openswarm.com/privacy and /terms URLs returned 404.
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Optional isolated PostgreSQL database used by integration tests only.
TEST_DATABASE_URL=

# Optional confirmation + priority email flow (server-only). Keep disabled until
# migration 003, the sending domain, public assets and authenticated worker are ready.
WAITLIST_EMAIL_ENABLED=false
RESEND_API_KEY=
WAITLIST_EMAIL_FROM=
WAITLIST_EMAIL_REPLY_TO=
WAITLIST_EMAIL_PUBLIC_URL=https://openswarm.com
# Independent random secrets, each at least 32 bytes. Never use referral codes.
WAITLIST_EMAIL_SECRET=
CRON_SECRET=
# Approved business mailing address for the email footer, if configured.
WAITLIST_EMAIL_POSTAL_ADDRESS=
